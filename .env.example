# BullyQuant configuration — copy to `.env` and fill in.
# `.env` is gitignored; nothing here (including your email) is ever committed.

# ── QuantConnect (required) ───────────────────────────────────────────────────
# From https://www.quantconnect.com/account
QC_USER_ID=
QC_API_TOKEN=

# ── Anthropic (required) ──────────────────────────────────────────────────────
# From https://console.anthropic.com
# If a host reserves the ANTHROPIC_API_KEY name for its own auth (and strips it
# from child processes), set BQ_ANTHROPIC_API_KEY instead — the loop reads either.
ANTHROPIC_API_KEY=

# ── Model tiers (optional overrides) ──────────────────────────────────────────
# FRONTIER runs the analyst (finding improvements) + ideation. Fable 5 needs
# 30-day data retention on your Anthropic org; set it to claude-opus-4-8 to
# avoid that requirement (the loop runs unchanged on Opus).
BQ_MODEL_FRONTIER=claude-fable-5
BQ_MODEL_STRONG=claude-opus-4-8
BQ_MODEL_MID=claude-sonnet-5
BQ_MODEL_CHEAP=claude-haiku-4-5
# Use Fable for ideation too (true) or fall back to Opus for ideation (false).
BQ_IDEATE_WITH_FRONTIER=true

# ── Guardrails ────────────────────────────────────────────────────────────────
BQ_MAX_GENERATIONS=8
BQ_MAX_BACKTESTS=24
# Stop if the best score doesn't improve for this many generations.
BQ_PLATEAU_PATIENCE=3
# Soft token budget across the whole campaign (USD-equivalent guard is approximate).
BQ_TOKEN_BUDGET=0            # 0 = unlimited

# ── Email (optional) ──────────────────────────────────────────────────────────
# Without these the loop still runs and just writes HTML reports under data/reports.
# For Gmail: EMAIL_SMTP_HOST=smtp.gmail.com, PORT=587, USER=you@gmail.com,
# PASS=<app password>. Nothing here is committed.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_TO=
EMAIL_FROM=

# ── Backtest window (optional defaults; --start/--end override) ────────────────
BQ_START=2022-01-01
BQ_END=2024-01-01
# Out-of-sample holdout window used for the anti-cheat re-test.
BQ_OOS_START=2024-01-01
BQ_OOS_END=2026-01-01
